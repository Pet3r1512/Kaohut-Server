{
  "name": "kaohut-server",
  "type": "module",
  "version": "1.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node ./dist/src/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "pnpm run lint --fix",
    "test": "cross-env NODE_ENV=test vitest",
    "build": "pnpm install --prod=false && tsc && tsc-alias",
    "heroku-postbuild": "pnpm run build",
    "prod:build": "pnpm prisma generate && pnpm build",
    "db:push": "pnpm prisma db push"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.2",
    "@hono/trpc-server": "^0.3.4",
    "@libsql/client": "^0.14.0",
    "@prisma/client": "^6.2.1",
    "@scalar/hono-api-reference": "^0.5.156",
    "@trpc/client": "11.0.0-rc.660",
    "@trpc/server": "11.0.0-rc.660",
    "better-auth": "^1.0.0",
    "dotenv": "^16.4.5",
    "dotenv-expand": "^11.0.6",
    "hono": "^4.6.6",
    "hono-pino": "^0.4.0",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "socket.io": "^4.8.1",
    "stoker": "^1.2.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^3.8.0",
    "@types/node": "^22.7.9",
    "cross-env": "^7.0.3",
    "eslint": "^9.13.0",
    "eslint-plugin-format": "^0.1.2",
    "prisma": "^6.2.1",
    "tsc-alias": "^1.8.10",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  },
  "packageManager": "pnpm@9.13.2",
  "optionalDependencies": {
    "bufferutil": "^4.0.8",
    "utf-8-validate": "^6.0.5"
  }
}